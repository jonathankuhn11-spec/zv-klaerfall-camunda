<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_zv-zahlung-pruefen" targetNamespace="http://bpmn.io/schema/bpmn" exporter="zv-klaerfall/tools/generate_models.py" exporterVersion="0.1.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:process id="zv-zahlung-pruefen" name="Zahlung prüfen und disponieren" isExecutable="true">
    <bpmn:extensionElements>
      <zeebe:versionTag value="1.0" />
    </bpmn:extensionElements>
    <bpmn:startEvent id="start_zahlung" name="Zahlung erhalten">
      <bpmn:outgoing>flow_start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="gw_merge_pruefen" name="">
      <bpmn:incoming>flow_start</bpmn:incoming>
      <bpmn:incoming>flow_korrigiert</bpmn:incoming>
      <bpmn:outgoing>flow_merge_pruefen</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="task_pruefen" name="Zahlung fachlich prüfen">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="zv.pruefen" retries="3" />
      <zeebe:taskHeaders>
        <zeebe:header key="betragslimit" value="50000.00" />
      </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_merge_pruefen</bpmn:incoming>
      <bpmn:outgoing>flow_zu_gw_befunde</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gw_befunde" name="Befunde vorhanden?" default="flow_befunde_nein">
      <bpmn:incoming>flow_zu_gw_befunde</bpmn:incoming>
      <bpmn:outgoing>flow_befunde_nein</bpmn:outgoing>
      <bpmn:outgoing>flow_befunde_ja</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_merge_freigeben" name="">
      <bpmn:incoming>flow_befunde_nein</bpmn:incoming>
      <bpmn:incoming>flow_freigeben</bpmn:incoming>
      <bpmn:outgoing>flow_merge_freigeben</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="task_freigeben" name="Zahlung freigeben und buchen">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="zv.freigeben" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow_merge_freigeben</bpmn:incoming>
      <bpmn:outgoing>flow_ende_freigegeben</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_freigegeben" name="Zahlung freigegeben (ACCP)">
      <bpmn:incoming>flow_ende_freigegeben</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="rule_klassifizieren" name="Klärfall klassifizieren (DMN)">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="klaerfall-klassifikation" resultVariable="klassifikation" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow_befunde_ja</bpmn:incoming>
      <bpmn:outgoing>flow_zu_gw_auto</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="gw_auto" name="Automatisch korrigierbar?" default="flow_auto_nein">
      <bpmn:incoming>flow_zu_gw_auto</bpmn:incoming>
      <bpmn:outgoing>flow_auto_ja</bpmn:outgoing>
      <bpmn:outgoing>flow_auto_nein</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="task_klaerfall" name="Klärfall bearbeiten">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="zv-klaerfall-form" />
        <zeebe:assignmentDefinition candidateGroups="=[klassifikation.zielTeam]" />
        <zeebe:taskSchedule dueDate="=now() + duration(klassifikation.sla)" />
        <zeebe:priorityDefinition priority="=if klassifikation.prioritaet = &quot;KRITISCH&quot; then 90 else if klassifikation.prioritaet = &quot;HOCH&quot; then 70 else if klassifikation.prioritaet = &quot;MITTEL&quot; then 50 else 30" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow_auto_nein</bpmn:incoming>
      <bpmn:outgoing>flow_zu_gw_entscheidung</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="timer_sla" name="SLA überschritten" attachedToRef="task_klaerfall" cancelActivity="false">
      <bpmn:outgoing>flow_sla</bpmn:outgoing>
      <bpmn:timerEventDefinition id="timer_sla_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=klassifikation.sla</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="gw_entscheidung" name="Entscheidung" default="flow_ablehnen">
      <bpmn:incoming>flow_zu_gw_entscheidung</bpmn:incoming>
      <bpmn:outgoing>flow_freigeben</bpmn:outgoing>
      <bpmn:outgoing>flow_ablehnen</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="task_ablehnen" name="Zahlung ablehnen">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="zv.ablehnen" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow_ablehnen</bpmn:incoming>
      <bpmn:outgoing>flow_ende_abgelehnt</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_abgelehnt" name="Zahlung abgelehnt (RJCT)">
      <bpmn:incoming>flow_ende_abgelehnt</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="task_korrigieren" name="Automatisch korrigieren">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="zv.korrigieren" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow_auto_ja</bpmn:incoming>
      <bpmn:outgoing>flow_korrigiert</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_eskalieren" name="Eskalation an Teamleitung">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="zv.eskalieren" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow_sla</bpmn:incoming>
      <bpmn:outgoing>flow_ende_eskaliert</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_eskaliert" name="Eskalation gemeldet">
      <bpmn:incoming>flow_ende_eskaliert</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_start" sourceRef="start_zahlung" targetRef="gw_merge_pruefen" />
    <bpmn:sequenceFlow id="flow_merge_pruefen" sourceRef="gw_merge_pruefen" targetRef="task_pruefen" />
    <bpmn:sequenceFlow id="flow_zu_gw_befunde" sourceRef="task_pruefen" targetRef="gw_befunde" />
    <bpmn:sequenceFlow id="flow_befunde_nein" name="nein" sourceRef="gw_befunde" targetRef="gw_merge_freigeben" />
    <bpmn:sequenceFlow id="flow_befunde_ja" name="ja" sourceRef="gw_befunde" targetRef="rule_klassifizieren">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=befundeVorhanden = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_zu_gw_auto" sourceRef="rule_klassifizieren" targetRef="gw_auto" />
    <bpmn:sequenceFlow id="flow_auto_ja" name="ja" sourceRef="gw_auto" targetRef="task_korrigieren">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=klassifikation.autoKorrektur = true and erneutePruefung = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_korrigiert" sourceRef="task_korrigieren" targetRef="gw_merge_pruefen" />
    <bpmn:sequenceFlow id="flow_auto_nein" name="nein" sourceRef="gw_auto" targetRef="task_klaerfall" />
    <bpmn:sequenceFlow id="flow_zu_gw_entscheidung" sourceRef="task_klaerfall" targetRef="gw_entscheidung" />
    <bpmn:sequenceFlow id="flow_freigeben" name="freigeben" sourceRef="gw_entscheidung" targetRef="gw_merge_freigeben">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=entscheidung = "FREIGEBEN"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_merge_freigeben" sourceRef="gw_merge_freigeben" targetRef="task_freigeben" />
    <bpmn:sequenceFlow id="flow_ablehnen" name="ablehnen" sourceRef="gw_entscheidung" targetRef="task_ablehnen" />
    <bpmn:sequenceFlow id="flow_ende_freigegeben" sourceRef="task_freigeben" targetRef="end_freigegeben" />
    <bpmn:sequenceFlow id="flow_ende_abgelehnt" sourceRef="task_ablehnen" targetRef="end_abgelehnt" />
    <bpmn:sequenceFlow id="flow_sla" sourceRef="timer_sla" targetRef="task_eskalieren" />
    <bpmn:sequenceFlow id="flow_ende_eskaliert" sourceRef="task_eskalieren" targetRef="end_eskaliert" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_zv-zahlung-pruefen">
    <bpmndi:BPMNPlane id="BPMNPlane_zv-zahlung-pruefen" bpmnElement="zv-zahlung-pruefen">
      <bpmndi:BPMNShape id="start_zahlung_di" bpmnElement="start_zahlung">
        <dc:Bounds x="152" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="114" y="224" width="112" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_merge_pruefen_di" bpmnElement="gw_merge_pruefen" isMarkerVisible="true">
        <dc:Bounds x="222" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_pruefen_di" bpmnElement="task_pruefen">
        <dc:Bounds x="300" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_befunde_di" bpmnElement="gw_befunde" isMarkerVisible="true">
        <dc:Bounds x="455" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="420" y="143" width="120" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_merge_freigeben_di" bpmnElement="gw_merge_freigeben" isMarkerVisible="true">
        <dc:Bounds x="995" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_freigeben_di" bpmnElement="task_freigeben">
        <dc:Bounds x="1080" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_freigegeben_di" bpmnElement="end_freigegeben">
        <dc:Bounds x="1232" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1190" y="224" width="120" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="rule_klassifizieren_di" bpmnElement="rule_klassifizieren">
        <dc:Bounds x="430" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_auto_di" bpmnElement="gw_auto" isMarkerVisible="true">
        <dc:Bounds x="585" y="315" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="550" y="283" width="120" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_klaerfall_di" bpmnElement="task_klaerfall">
        <dc:Bounds x="700" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="timer_sla_di" bpmnElement="timer_sla">
        <dc:Bounds x="732" y="362" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="774" y="373" width="119" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_entscheidung_di" bpmnElement="gw_entscheidung" isMarkerVisible="true">
        <dc:Bounds x="915" y="315" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="898" y="371" width="84" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_ablehnen_di" bpmnElement="task_ablehnen">
        <dc:Bounds x="1080" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_abgelehnt_di" bpmnElement="end_abgelehnt">
        <dc:Bounds x="1232" y="322" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1190" y="364" width="120" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_korrigieren_di" bpmnElement="task_korrigieren">
        <dc:Bounds x="560" y="440" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_eskalieren_di" bpmnElement="task_eskalieren">
        <dc:Bounds x="700" y="440" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_eskaliert_di" bpmnElement="end_eskaliert">
        <dc:Bounds x="852" y="462" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="810" y="504" width="120" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_di" bpmnElement="flow_start">
        <di:waypoint x="188" y="200" />
        <di:waypoint x="222" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_merge_pruefen_di" bpmnElement="flow_merge_pruefen">
        <di:waypoint x="272" y="200" />
        <di:waypoint x="300" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_zu_gw_befunde_di" bpmnElement="flow_zu_gw_befunde">
        <di:waypoint x="400" y="200" />
        <di:waypoint x="455" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_befunde_nein_di" bpmnElement="flow_befunde_nein">
        <di:waypoint x="505" y="200" />
        <di:waypoint x="995" y="200" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="738" y="182" width="24" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_befunde_ja_di" bpmnElement="flow_befunde_ja">
        <di:waypoint x="480" y="225" />
        <di:waypoint x="480" y="300" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="486" y="258" width="14" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_zu_gw_auto_di" bpmnElement="flow_zu_gw_auto">
        <di:waypoint x="530" y="340" />
        <di:waypoint x="585" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_auto_ja_di" bpmnElement="flow_auto_ja">
        <di:waypoint x="610" y="365" />
        <di:waypoint x="610" y="440" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="616" y="396" width="14" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_korrigiert_di" bpmnElement="flow_korrigiert">
        <di:waypoint x="560" y="480" />
        <di:waypoint x="247" y="480" />
        <di:waypoint x="247" y="225" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_auto_nein_di" bpmnElement="flow_auto_nein">
        <di:waypoint x="635" y="340" />
        <di:waypoint x="700" y="340" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="656" y="322" width="24" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_zu_gw_entscheidung_di" bpmnElement="flow_zu_gw_entscheidung">
        <di:waypoint x="800" y="340" />
        <di:waypoint x="915" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_freigeben_di" bpmnElement="flow_freigeben">
        <di:waypoint x="940" y="315" />
        <di:waypoint x="940" y="260" />
        <di:waypoint x="1020" y="260" />
        <di:waypoint x="1020" y="225" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="956" y="242" width="48" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_merge_freigeben_di" bpmnElement="flow_merge_freigeben">
        <di:waypoint x="1045" y="200" />
        <di:waypoint x="1080" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_ablehnen_di" bpmnElement="flow_ablehnen">
        <di:waypoint x="965" y="340" />
        <di:waypoint x="1080" y="340" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1000" y="322" width="44" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_ende_freigegeben_di" bpmnElement="flow_ende_freigegeben">
        <di:waypoint x="1180" y="200" />
        <di:waypoint x="1232" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_ende_abgelehnt_di" bpmnElement="flow_ende_abgelehnt">
        <di:waypoint x="1180" y="340" />
        <di:waypoint x="1232" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_sla_di" bpmnElement="flow_sla">
        <di:waypoint x="750" y="398" />
        <di:waypoint x="750" y="440" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_ende_eskaliert_di" bpmnElement="flow_ende_eskaliert">
        <di:waypoint x="800" y="480" />
        <di:waypoint x="852" y="480" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
